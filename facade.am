// ═══════════════════════════════════════════════════════
//  imap.am  —  IMAP4rev1 server (read access to the store)
// ═══════════════════════════════════════════════════════
//
// Phase 4 of the native Amalgame mail server. Lets a mail client
// (Thunderbird / K-9 / Apple Mail) connect and read the messages SMTP
// delivered into an `amalgame-net-mail-store` MailStore.
//
//   ImapSession — the IMAP command state machine. Pure logic: feed it
//                 one tagged command line and it returns the response
//                 (untagged data lines + the tagged completion). No
//                 socket, no TLS → unit-testable with strings.
//   ImapServer  — the TcpServer accept loop + STARTTLS upgrade
//                 (same transport as amalgame-net-smtp-server).
//
// AUTH (LOGIN) verifies scrypt hashes via amalgame-crypto Password.Verify
// — the same hashes amalgame-auth stores (one unified account). LOGIN is
// refused before TLS.
//
// Coverage (v0.1.0): CAPABILITY, STARTTLS, LOGIN, LIST/LSUB, SELECT/
// EXAMINE, FETCH + UID FETCH (FLAGS, UID, RFC822.SIZE, BODY[]/RFC822 /
// BODY.PEEK[]), STORE + UID STORE (FLAGS / +FLAGS / -FLAGS [.SILENT]),
// SEARCH/UID SEARCH (ALL + UNSEEN/SEEN/DELETED), EXPUNGE, CLOSE, NOOP,
// CHECK, LOGOUT.
//
// Out of scope (v0.1.0): ENVELOPE / BODYSTRUCTURE / partial BODY[<n>]
// (clients can fetch the whole message and parse with formats-mime);
// IDLE; per-recipient routing; folders beyond what the store exposes.

// Per-user store routing : maps an authenticated login to ITS own MailStore,
// so each account reads its own mailbox instead of a shared one. Injected by
// the consumer (closure), null = single shared store (legacy behaviour).
public class StoreResolver {
    public Fn: Closure<string, MailStore>
    public StoreResolver(Closure<string, MailStore> fn) { this.Fn = fn }
}

public class ImapSession {
    public  Store:     MailStore
    public  Users:     Map<string, string>
    public  TlsActive: bool
    public  Authed:    bool
    public  AuthUser:  string
    public  Resolver:  StoreResolver     // per-user store routing (null = shared)

    private SelMb:     string          // selected mailbox ("" = none)
    private SelUids:   List<int>       // UID snapshot taken at SELECT (seq = index+1)
    private SelFlags:  List<string>    // flags snapshot parallèle à SelUids (sync lu/non-lu)
    private Upgrade:   bool
    private LoggedOut: bool
    private AuthFails: int             // failed LOGINs (brute-force lockout)
    private MaxAuthFails: int

    public ImapSession(store: MailStore, host: string) {
        this.Store     = store
        this.Resolver  = null
        this.Users     = new Map<string, string>()
        this.TlsActive = false
        this.Authed    = false
        this.AuthUser  = ""
        this.SelMb     = ""
        this.SelUids   = new List<int>()
        this.SelFlags  = new List<string>()
        this.Upgrade   = false
        this.LoggedOut = false
        this.AuthFails = 0
        this.MaxAuthFails = 5
    }

    public void AddPassword(string name, string plaintext) { this.Users.Set(name, Password.Hash(plaintext)) }
    public void AddUserHash(string name, string hash)      { this.Users.Set(name, hash) }
    public bool IsLoggedOut() { return this.LoggedOut }
    public bool WantsTlsUpgrade() { return this.Upgrade }
    public void SetTlsActive(bool on) { this.TlsActive = on; this.Upgrade = false }

    public string Greeting() {
        return "* OK [CAPABILITY IMAP4rev1 STARTTLS] Amalgame IMAP ready\r\n"
    }

    // Process one tagged command line (CRLF already stripped).
    public string Feed(string line) {
        let tag: string = ImapSession.token(line, 0)
        let cmd: string = String_ToUpper(ImapSession.token(line, 1))
        let rest: string = ImapSession.after(line, 2)
        if (String_Length(tag) == 0) { return "* BAD empty tag\r\n" }
        Console.WriteLine("[imap] " + cmd + (cmd == "LOGIN" ? " <redacted>" : " " + rest))

        if (cmd == "CAPABILITY") { return this.cap() + tag + " OK CAPABILITY completed\r\n" }
        // NOOP/CHECK : notifie les nouveaux messages arrivés depuis le snapshot
        // (* n EXISTS non sollicité) → un client qui « relève » via NOOP les voit.
        if (cmd == "NOOP")  { return this.pollChanges() + tag + " OK NOOP completed\r\n" }
        if (cmd == "CHECK") { return this.pollChanges() + tag + " OK CHECK completed\r\n" }
        if (cmd == "LOGOUT") { this.LoggedOut = true; return "* BYE Amalgame IMAP logging out\r\n" + tag + " OK LOGOUT completed\r\n" }
        if (cmd == "STARTTLS") {
            if (this.TlsActive) { return tag + " BAD Already using TLS\r\n" }
            this.Upgrade = true
            return tag + " OK Begin TLS negotiation now\r\n"
        }
        if (cmd == "LOGIN") { return this.login(tag, rest) }

        // everything below requires authentication
        if (!this.Authed) { return tag + " NO Not authenticated\r\n" }

        if (cmd == "LIST" || cmd == "LSUB") { return this.list(tag, cmd) }
        if (cmd == "STATUS") { return this.status(tag, rest) }
        if (cmd == "CREATE") { return tag + " OK CREATE completed\r\n" }   // no-op (le store crée à la livraison)
        if (cmd == "SUBSCRIBE" || cmd == "UNSUBSCRIBE") { return tag + " OK " + cmd + " completed\r\n" }
        if (cmd == "SELECT" || cmd == "EXAMINE") { return this.select(tag, rest, cmd == "EXAMINE") }
        if (cmd == "FETCH")  { return this.fetch(tag, rest, false) }
        if (cmd == "STORE")  { return this.store(tag, rest, false) }
        if (cmd == "SEARCH") { return this.search(tag, rest, false) }
        if (cmd == "EXPUNGE") { return this.expunge(tag) }
        if (cmd == "COPY") { return this.copy(tag, rest, false) }
        if (cmd == "MOVE") { return this.move(tag, rest, false) }
        if (cmd == "CLOSE") { let e: string = this.expungeSilent(); this.SelMb = ""; return tag + " OK CLOSE completed\r\n" }
        if (cmd == "UID") {
            let sub: string = String_ToUpper(ImapSession.token(rest, 0))
            let subRest: string = ImapSession.after(rest, 1)
            if (sub == "FETCH")  { return this.fetch(tag, subRest, true) }
            if (sub == "STORE")  { return this.store(tag, subRest, true) }
            if (sub == "SEARCH") { return this.search(tag, subRest, true) }
            if (sub == "COPY")   { return this.copy(tag, subRest, true) }
            if (sub == "MOVE")   { return this.move(tag, subRest, true) }
            return tag + " BAD UID subcommand unsupported\r\n"
        }
        return tag + " BAD Command unrecognized\r\n"
    }

    // ── command handlers ──────────────────────────────

    private string cap() {
        if (this.TlsActive) { return "* CAPABILITY IMAP4rev1 MOVE\r\n" }
        return "* CAPABILITY IMAP4rev1 STARTTLS LOGINDISABLED\r\n"
    }

    private string login(string tag, string rest) {
        if (!this.TlsActive) { return tag + " NO [PRIVACYREQUIRED] TLS required before LOGIN\r\n" }
        if (this.AuthFails >= this.MaxAuthFails) { return tag + " NO [AUTHFAILED] too many login attempts\r\n" }
        let user: string = ImapSession.unquote(ImapSession.token(rest, 0))
        let pass: string = ImapSession.unquote(ImapSession.token(rest, 1))
        if (this.Users.Has(user) && Password.Verify(pass, this.Users.Get(user))) {
            this.Authed = true
            this.AuthUser = user
            this.AuthFails = 0
            // Per-user store routing : switch to THIS user's mailbox store.
            if (this.Resolver != null) { this.Store = this.Resolver.Fn(user) }
            return tag + " OK LOGIN completed\r\n"
        }
        this.AuthFails = this.AuthFails + 1
        return tag + " NO [AUTHFAILED] LOGIN failed\r\n"
    }

    private string list(string tag, string cmd) {
        var out: string = ""
        let mbs: List<string> = this.Store.Mailboxes()
        let n: int = mbs.Count()
        // Always advertise INBOX even if the store has no mailbox row yet.
        var sawInbox: bool = false
        for i in 0..n {
            let nm: string = mbs.Get(i)
            if (nm == "INBOX") { sawInbox = true }
            out = out + "* " + cmd + " (\\HasNoChildren) \"/\" \"" + nm + "\"\r\n"
        }
        if (!sawInbox) { out = "* " + cmd + " (\\HasNoChildren) \"/\" \"INBOX\"\r\n" + out }
        return out + tag + " OK " + cmd + " completed\r\n"
    }

    // Capture l'état des flags parallèlement à SelUids (pour la synchro lu/non-lu).
    private void captureFlags() {
        this.SelFlags = new List<string>()
        var i: int = 0
        while (i < this.SelUids.Count()) {
            this.SelFlags.Add(this.Store.Flags(this.SelMb, this.SelUids.Get(i)))
            i = i + 1
        }
    }

    // Synchro non sollicitée (NOOP/CHECK) : compare l'état courant du store au
    // snapshot et émet EXPUNGE (messages supprimés ailleurs, ex. webmail),
    // EXISTS (nouveaux) et FETCH FLAGS (lu/non-lu changé). Rafraîchit le snapshot.
    private string pollChanges() {
        if (String_Length(this.SelMb) == 0) { return "" }
        let cur: List<int> = this.Store.Uids(this.SelMb)
        var out: string = ""
        // 1. EXPUNGE des UID du snapshot disparus (seq ancien, ajusté des expunges déjà émis).
        var removed: int = 0
        var i: int = 0
        while (i < this.SelUids.Count()) {
            let uid: int = this.SelUids.Get(i)
            if (!ImapSession.hasInt(cur, uid)) {
                out = out + "* " + String_FromInt(i + 1 - removed) + " EXPUNGE\r\n"
                removed = removed + 1
            }
            i = i + 1
        }
        // 2. EXISTS si de nouveaux messages.
        let surv: int = this.SelUids.Count() - removed
        if (cur.Count() > surv) { out = out + "* " + String_FromInt(cur.Count()) + " EXISTS\r\n* 0 RECENT\r\n" }
        // 3. FETCH FLAGS pour les survivants dont les flags ont changé (seq sur `cur`).
        var j: int = 0
        while (j < cur.Count()) {
            let uid: int = cur.Get(j)
            let oldIdx: int = ImapSession.indexOfInt(this.SelUids, uid)
            if (oldIdx >= 0) {
                let nowFl: string = this.Store.Flags(this.SelMb, uid)
                if (nowFl != this.SelFlags.Get(oldIdx)) {
                    out = out + "* " + String_FromInt(j + 1) + " FETCH (UID " + String_FromInt(uid) + " FLAGS (" + nowFl + "))\r\n"
                }
            }
            j = j + 1
        }
        this.SelUids = cur
        this.captureFlags()
        return out
    }
    private static bool hasInt(List<int> l, int x) {
        var i: int = 0
        while (i < l.Count()) { if (l.Get(i) == x) { return true } i = i + 1 }
        return false
    }
    private static int indexOfInt(List<int> l, int x) {
        var i: int = 0
        while (i < l.Count()) { if (l.Get(i) == x) { return i } i = i + 1 }
        return -1
    }

    // INBOX est insensible à la casse (RFC 3501) : "Inbox"/"inbox" → "INBOX".
    private static string normMb(string mb) {
        if (String_ToUpper(mb) == "INBOX") { return "INBOX" }
        return mb
    }

    // STATUS <mailbox> (items) — un client mobile l'utilise pour détecter les
    // nouveaux mails (MESSAGES/UIDNEXT/UNSEEN) sans SELECT.
    private string status(string tag, string rest) {
        let raw: string = ImapSession.token(rest, 0)
        let mb: string = ImapSession.normMb(ImapSession.unquote(raw))
        let uids: List<int> = this.Store.Uids(mb)
        let msgs: int = uids.Count()
        let uidv: int = this.Store.UidValidity(mb)
        let uidn: int = this.Store.UidNext(mb)
        var unseen: int = 0
        var i: int = 0
        while (i < uids.Count()) {
            let fl: string = this.Store.Flags(mb, uids.Get(i))
            if (!String_Contains(fl, "\\Seen")) { unseen = unseen + 1 }
            i = i + 1
        }
        var s: string = "* STATUS " + raw + " (MESSAGES " + String_FromInt(msgs)
            + " RECENT 0 UIDNEXT " + String_FromInt(uidn) + " UIDVALIDITY " + String_FromInt(uidv)
            + " UNSEEN " + String_FromInt(unseen) + ")\r\n"
        return s + tag + " OK STATUS completed\r\n"
    }

    private string select(string tag, string rest, bool examine) {
        let mb: string = ImapSession.normMb(ImapSession.unquote(ImapSession.token(rest, 0)))
        this.SelMb = mb
        this.SelUids = this.Store.Uids(mb)
        this.captureFlags()
        let cnt: int = this.SelUids.Count()
        let uidv: int = this.Store.UidValidity(mb)
        let uidn: int = this.Store.UidNext(mb)
        var out: string = ""
        out = out + "* " + String_FromInt(cnt) + " EXISTS\r\n"
        out = out + "* 0 RECENT\r\n"
        out = out + "* OK [UIDVALIDITY " + String_FromInt(uidv) + "] UIDs valid\r\n"
        out = out + "* OK [UIDNEXT " + String_FromInt(uidn) + "] Predicted next UID\r\n"
        out = out + "* FLAGS (\\Seen \\Answered \\Flagged \\Deleted \\Draft)\r\n"
        out = out + "* OK [PERMANENTFLAGS (\\Seen \\Answered \\Flagged \\Deleted \\Draft)] Limited\r\n"
        if (examine) { return out + tag + " OK [READ-ONLY] EXAMINE completed\r\n" }
        return out + tag + " OK [READ-WRITE] SELECT completed\r\n"
    }

    private string fetch(string tag, string rest, bool byUid) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let setSpec: string = ImapSession.token(rest, 0)
        let rawItems: string = ImapSession.after(rest, 1)   // garde la casse (labels BODY[...])
        var out: string = ""
        let cnt: int = this.SelUids.Count()
        for s in 1..(cnt + 1) {
            let uid: int = this.SelUids.Get(s - 1)
            var hit: bool = false
            if (byUid) { hit = ImapSession.inSet(setSpec, uid, this.maxUid()) }
            else { hit = ImapSession.inSet(setSpec, s, cnt) }
            if (hit) { out = out + this.fetchOne(s, uid, byUid, rawItems) }
        }
        return out + tag + " OK " + this.uidTag(byUid) + "FETCH completed\r\n"
    }

    private string fetchOne(int seq, int uid, bool byUid, string rawItems) {
        let up: string = String_ToUpper(rawItems)
        let msg: string = this.Store.Read(this.SelMb, uid)
        var parts: string = ""
        if (byUid || String_Contains(up, "UID")) { parts = ImapSession.join(parts, "UID " + String_FromInt(uid)) }
        if (String_Contains(up, "FLAGS")) {
            parts = ImapSession.join(parts, "FLAGS (" + this.Store.Flags(this.SelMb, uid) + ")")
        }
        if (String_Contains(up, "INTERNALDATE")) {
            parts = ImapSession.join(parts, "INTERNALDATE \"" + ImapSession.internalDate(msg) + "\"")
        }
        if (String_Contains(up, "RFC822.SIZE")) {
            parts = ImapSession.join(parts, "RFC822.SIZE " + String_FromInt(this.Store.Size(this.SelMb, uid)))
        }
        // Section BODY[...] / BODY.PEEK[...] (HEADER.FIELDS / HEADER / TEXT / vide).
        let bspec: string = ImapSession.bodySpec(rawItems)
        if (bspec != "<none>") {
            let content: string = ImapSession.sectionContent(msg, bspec)
            parts = ImapSession.join(parts, "BODY[" + bspec + "] {" + String_FromInt(String_Length(content)) + "}\r\n" + content)
            if (!String_Contains(up, "BODY.PEEK")) { this.Store.SetFlags(this.SelMb, uid, "\\Seen") }
        }
        else if (String_Contains(up, "RFC822.HEADER")) {
            let c: string = ImapSession.sectionContent(msg, "HEADER")
            parts = ImapSession.join(parts, "RFC822.HEADER {" + String_FromInt(String_Length(c)) + "}\r\n" + c)
        }
        else if (String_Contains(up, "RFC822.TEXT")) {
            let c: string = ImapSession.sectionContent(msg, "TEXT")
            parts = ImapSession.join(parts, "RFC822.TEXT {" + String_FromInt(String_Length(c)) + "}\r\n" + c)
            this.Store.SetFlags(this.SelMb, uid, "\\Seen")
        }
        else if (String_Contains(up, "RFC822")) {
            parts = ImapSession.join(parts, "RFC822 {" + String_FromInt(String_Length(msg)) + "}\r\n" + msg)
            this.Store.SetFlags(this.SelMb, uid, "\\Seen")
        }
        // BODYSTRUCTURE : structure MIME (réutilise un parseur simple).
        if (String_Contains(up, "BODYSTRUCTURE")) {
            parts = ImapSession.join(parts, "BODYSTRUCTURE " + ImapSession.bodyStructure(msg))
        }
        return "* " + String_FromInt(seq) + " FETCH (" + parts + ")\r\n"
    }

    // Renvoie le contenu entre crochets d'un BODY[...]/BODY.PEEK[...], ou "<none>".
    private static string bodySpec(string items) {
        let up: string = String_ToUpper(items)
        var start: int = -1
        let pk: int = String_IndexOf(up, "BODY.PEEK[")
        if (pk >= 0) { start = pk + 10 }
        else { let b: int = String_IndexOf(up, "BODY["); if (b >= 0) { start = b + 5 } }
        if (start < 0) { return "<none>" }
        let tail: string = String_Substring(items, start, String_Length(items) - start)
        let close: int = String_IndexOf(tail, "]")
        if (close < 0) { return "<none>" }
        return String_Substring(tail, 0, close)
    }

    // Header block (avant la ligne vide) d'un message brut.
    private static string headerBlock(string msg) {
        let split: int = String_IndexOf(msg, "\r\n\r\n")
        if (split < 0) { return msg }
        return String_Substring(msg, 0, split)
    }
    private static string bodyPart(string msg) {
        let split: int = String_IndexOf(msg, "\r\n\r\n")
        if (split < 0) { return "" }
        return String_Substring(msg, split + 4, String_Length(msg) - split - 4)
    }
    // Contenu d'une section BODY[spec].
    private static string sectionContent(string msg, string spec) {
        let trimmed: string = String_Trim(spec)
        let up: string = String_ToUpper(trimmed)
        if (String_Length(up) == 0) { return msg }                       // BODY[]
        if (up == "HEADER") { return ImapSession.headerBlock(msg) + "\r\n\r\n" }
        if (up == "TEXT") { return ImapSession.bodyPart(msg) }            // corps brut (haut niveau)
        if (String_StartsWith(up, "HEADER.FIELDS")) {
            let lp: int = String_IndexOf(spec, "(")
            let rp: int = String_IndexOf(spec, ")")
            var fields: string = ""
            if (lp >= 0 && rp > lp) { fields = String_Substring(spec, lp + 1, rp - lp - 1) }
            return ImapSession.selectFields(ImapSession.headerBlock(msg), fields) + "\r\n"
        }
        // Section numérotée "1", "2", "1.1" (+ suffixe .TEXT/.MIME) → partie MIME.
        // On renvoie le corps BRUT de la partie (encodage déclaré dans BODYSTRUCTURE,
        // décodé par le client) — c'est ainsi qu'une pièce jointe (image) est servie.
        if (ImapSession.startsDigit(trimmed)) {
            var path: string = trimmed
            let dot: int = String_IndexOf(up, ".")
            if (dot >= 0) {
                let suf: string = String_Substring(up, dot + 1, String_Length(up) - dot - 1)
                if (suf == "MIME" || suf == "TEXT" || suf == "HEADER") { path = String_Substring(trimmed, 0, dot) }
            }
            let part: MimePart = ImapSession.navPart(Mime.Parse(msg), path)
            return part.RawBody
        }
        return msg
    }
    // En-têtes demandés (sous-ensemble), dans l'ordre du message, repliage conservé.
    private static string selectFields(string hdr, string fieldsStr) {
        let wanted: string = " " + String_ToLower(fieldsStr) + " "
        let lines: List<string> = String_Split(hdr, "\r\n")
        var out: string = ""
        var keep: bool = false
        var i: int = 0
        while (i < lines.Count()) {
            let ln: string = lines.Get(i)
            i = i + 1
            if (String_Length(ln) > 0) {
                let c0: string = String_Substring(ln, 0, 1)
                if (c0 == " " || c0 == "\t") {
                    if (keep) { out = out + ln + "\r\n" }
                } else {
                    let colon: int = String_IndexOf(ln, ":")
                    var name: string = ""
                    if (colon >= 0) { name = String_ToLower(String_Trim(String_Substring(ln, 0, colon))) }
                    keep = String_Length(name) > 0 && String_Contains(wanted, " " + name + " ")
                    if (keep) { out = out + ln + "\r\n" }
                }
            }
        }
        return out
    }
    // Valeur (repliée) d'un en-tête nommé.
    private static string headerVal(string hdr, string name) {
        let lines: List<string> = String_Split(hdr, "\r\n")
        let want: string = String_ToLower(name) + ":"
        var val: string = ""
        var cap: bool = false
        var i: int = 0
        while (i < lines.Count()) {
            let ln: string = lines.Get(i)
            i = i + 1
            if (cap) {
                let c0: string = String_Length(ln) > 0 ? String_Substring(ln, 0, 1) : ""
                if (c0 == " " || c0 == "\t") { val = val + " " + String_Trim(ln) }
                else { i = lines.Count() }
            } else if (String_StartsWith(String_ToLower(ln), want)) {
                val = String_Trim(String_Substring(ln, String_Length(want), String_Length(ln) - String_Length(want)))
                cap = true
            }
        }
        return val
    }
    // Date d'en-tête RFC 5322 → INTERNALDATE IMAP ("DD-Mon-YYYY HH:MM:SS +ZZZZ").
    private static string internalDate(string msg) {
        let d: string = ImapSession.headerVal(ImapSession.headerBlock(msg), "date")
        var s: string = d
        let comma: int = String_IndexOf(s, ",")
        if (comma >= 0) { s = String_Substring(s, comma + 1, String_Length(s) - comma - 1) }
        s = String_Trim(s)
        let raw: List<string> = String_Split(s, " ")
        let toks: List<string> = new List<string>()
        var i: int = 0
        while (i < raw.Count()) { let t: string = raw.Get(i); if (String_Length(t) > 0) { toks.Add(t) } i = i + 1 }
        if (toks.Count() >= 5) {
            var day: string = toks.Get(0)
            if (String_Length(day) == 1) { day = "0" + day }
            return day + "-" + toks.Get(1) + "-" + toks.Get(2) + " " + toks.Get(3) + " " + toks.Get(4)
        }
        return "01-Jan-2020 00:00:00 +0000"
    }
    private static bool startsDigit(string s) {
        if (String_Length(s) == 0) { return false }
        let c: string = String_Substring(s, 0, 1)
        return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
            || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
    }
    // Navigue jusqu'à la partie MIME désignée par un chemin "2" ou "1.1".
    private static MimePart navPart(MimePart top, string path) {
        let nums: List<string> = String_Split(path, ".")
        var cur: MimePart = top
        var i: int = 0
        while (i < nums.Count()) {
            let idx: int = String_ToInt(nums.Get(i)) - 1
            if (cur.IsMultipart()) {
                let kids: List<MimePart> = cur.Parts()
                if (idx >= 0 && idx < kids.Count()) { cur = cur.PartAt(idx) }
            }
            i = i + 1
        }
        return cur
    }
    // Sous-type d'un Content-Type ("multipart/mixed; ..." → "mixed").
    private static string subtypeOf(string ct) {
        let slash: int = String_IndexOf(ct, "/")
        if (slash < 0) { return "MIXED" }
        var s: string = String_Substring(ct, slash + 1, String_Length(ct) - slash - 1)
        let semi: int = String_IndexOf(s, ";")
        if (semi >= 0) { s = String_Substring(s, 0, semi) }
        return String_Trim(s)
    }
    // BODYSTRUCTURE : structure MIME RÉELLE (récursive) → le client voit chaque
    // partie, dont les pièces jointes (NAME=fichier), et récupère BODY[<n>].
    private static string bodyStructure(string msg) {
        return ImapSession.bodyStructureOf(Mime.Parse(msg))
    }
    private static string bodyStructureOf(MimePart p) {
        if (p.IsMultipart()) {
            let kids: List<MimePart> = p.Parts()
            var inner: string = ""
            var i: int = 0
            while (i < kids.Count()) { inner = inner + ImapSession.bodyStructureOf(kids.Get(i)); i = i + 1 }
            return "(" + inner + " \"" + String_ToUpper(ImapSession.subtypeOf(p.ContentType())) + "\")"
        }
        let ct: string = p.ContentType()
        let slash: int = String_IndexOf(ct, "/")
        var typ: string = ct
        var sub: string = "PLAIN"
        if (slash >= 0) {
            typ = String_Substring(ct, 0, slash)
            sub = ImapSession.subtypeOf(ct)
        }
        typ = String_ToUpper(String_Trim(typ))
        sub = String_ToUpper(sub)
        var enc: string = String_ToUpper(String_Trim(p.Encoding()))
        if (String_Length(enc) == 0) { enc = "7BIT" }
        let octets: int = String_Length(p.RawBody)
        if (typ == "TEXT") {
            var cs: string = p.Charset()
            if (String_Length(cs) == 0) { cs = "utf-8" }
            var lines: int = 0
            var k: int = 0
            while (k < String_Length(p.RawBody)) { if (String_Substring(p.RawBody, k, 1) == "\n") { lines = lines + 1 } k = k + 1 }
            return "(\"TEXT\" \"" + sub + "\" (\"CHARSET\" \"" + cs + "\") NIL NIL \"" + enc + "\" " + String_FromInt(octets) + " " + String_FromInt(lines) + " NIL NIL NIL)"
        }
        let fn: string = p.Filename()
        var param: string = "NIL"
        var dsp: string = "NIL"
        if (String_Length(fn) > 0) {
            param = "(\"NAME\" \"" + fn + "\")"
            // body-fld-dsp : indispensable pour qu'un client mobile montre la
            // pièce jointe (sinon traitée comme inline → invisible).
            dsp = "(\"attachment\" (\"FILENAME\" \"" + fn + "\"))"
        }
        return "(\"" + typ + "\" \"" + sub + "\" " + param + " NIL NIL \"" + enc + "\" " + String_FromInt(octets) + " NIL " + dsp + " NIL)"
    }

    private string store(string tag, string rest, bool byUid) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let setSpec: string = ImapSession.token(rest, 0)
        let op: string = String_ToUpper(ImapSession.token(rest, 1))
        let flagsArg: string = ImapSession.after(rest, 2)
        let silent: bool = String_Contains(op, ".SILENT")
        let newFlags: string = ImapSession.stripParens(flagsArg)
        var out: string = ""
        let cnt: int = this.SelUids.Count()
        for s in 1..(cnt + 1) {
            let uid: int = this.SelUids.Get(s - 1)
            var hit: bool = false
            if (byUid) { hit = ImapSession.inSet(setSpec, uid, this.maxUid()) }
            else { hit = ImapSession.inSet(setSpec, s, cnt) }
            if (hit) {
                let cur: string = this.Store.Flags(this.SelMb, uid)
                let updated: string = ImapSession.applyFlags(cur, op, newFlags)
                this.Store.SetFlags(this.SelMb, uid, updated)
                if (!silent) {
                    var parts: string = ""
                    if (byUid) { parts = "UID " + String_FromInt(uid) + " " }
                    out = out + "* " + String_FromInt(s) + " FETCH (" + parts + "FLAGS (" + updated + "))\r\n"
                }
            }
        }
        return out + tag + " OK " + this.uidTag(byUid) + "STORE completed\r\n"
    }

    private string search(string tag, string rest, bool byUid) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let crit: string = String_ToUpper(String_Trim(rest))
        var nums: string = ""
        let cnt: int = this.SelUids.Count()
        for s in 1..(cnt + 1) {
            let uid: int = this.SelUids.Get(s - 1)
            let fl: string = this.Store.Flags(this.SelMb, uid)
            var keep: bool = false
            if (crit == "ALL" || String_Length(crit) == 0) { keep = true }
            else if (crit == "UNSEEN" || crit == "NEW") { keep = !String_Contains(fl, "\\Seen") }
            else if (crit == "SEEN") { keep = String_Contains(fl, "\\Seen") }
            else if (crit == "DELETED") { keep = String_Contains(fl, "\\Deleted") }
            else if (crit == "FLAGGED") { keep = String_Contains(fl, "\\Flagged") }
            else { keep = true }   // unknown criteria → be permissive (return all)
            if (keep) {
                var v: int = s
                if (byUid) { v = uid }
                if (String_Length(nums) > 0) { nums = nums + " " }
                nums = nums + String_FromInt(v)
            }
        }
        return "* SEARCH " + nums + "\r\n" + tag + " OK " + this.uidTag(byUid) + "SEARCH completed\r\n"
    }

    private string expunge(string tag) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let out: string = this.expungeSilent()
        return out + tag + " OK EXPUNGE completed\r\n"
    }

    // Delete \Deleted messages; emit "* <seq> EXPUNGE" high→low so the
    // client's sequence numbers stay consistent. Refreshes SelUids.
    private string expungeSilent() {
        var out: string = ""
        let cnt: int = this.SelUids.Count()
        // walk high seq → low
        var s: int = cnt
        while (s >= 1) {
            let uid: int = this.SelUids.Get(s - 1)
            let fl: string = this.Store.Flags(this.SelMb, uid)
            if (String_Contains(fl, "\\Deleted")) {
                this.Store.Delete(this.SelMb, uid)
                out = out + "* " + String_FromInt(s) + " EXPUNGE\r\n"
            }
            s = s - 1
        }
        this.SelUids = this.Store.Uids(this.SelMb)
        this.captureFlags()
        return out
    }

    // COPY <set> <mailbox> : copie les messages vers un autre dossier (même compte).
    private string copy(string tag, string rest, bool byUid) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let setSpec: string = ImapSession.token(rest, 0)
        let target: string = ImapSession.normMb(ImapSession.unquote(ImapSession.token(rest, 1)))
        let cnt: int = this.SelUids.Count()
        var okAll: bool = true
        for s in 1..(cnt + 1) {
            let uid: int = this.SelUids.Get(s - 1)
            var hit: bool = false
            if (byUid) { hit = ImapSession.inSet(setSpec, uid, this.maxUid()) }
            else { hit = ImapSession.inSet(setSpec, s, cnt) }
            if (hit) {
                let raw: string = this.Store.Read(this.SelMb, uid)
                if (String_Length(raw) > 0) { let nu: int = this.Store.Deliver(target, raw); if (nu <= 0) { okAll = false } }
            }
        }
        if (!okAll) { return tag + " NO COPY failed\r\n" }
        return tag + " OK " + this.uidTag(byUid) + "COPY completed\r\n"
    }

    // MOVE <set> <mailbox> (RFC 6851) : copie + supprime de la source + EXPUNGE.
    // C'est ce qu'un client mobile fait pour « supprimer » (déplacer en Corbeille).
    private string move(string tag, string rest, bool byUid) {
        if (String_Length(this.SelMb) == 0) { return tag + " NO No mailbox selected\r\n" }
        let setSpec: string = ImapSession.token(rest, 0)
        let target: string = ImapSession.normMb(ImapSession.unquote(ImapSession.token(rest, 1)))
        var out: string = ""
        let cnt: int = this.SelUids.Count()
        var s: int = cnt
        while (s >= 1) {
            let uid: int = this.SelUids.Get(s - 1)
            var hit: bool = false
            if (byUid) { hit = ImapSession.inSet(setSpec, uid, this.maxUid()) }
            else { hit = ImapSession.inSet(setSpec, s, cnt) }
            if (hit) {
                let raw: string = this.Store.Read(this.SelMb, uid)
                if (String_Length(raw) > 0) { this.Store.Deliver(target, raw) }
                this.Store.Delete(this.SelMb, uid)
                out = out + "* " + String_FromInt(s) + " EXPUNGE\r\n"
            }
            s = s - 1
        }
        this.SelUids = this.Store.Uids(this.SelMb)
        this.captureFlags()
        return out + tag + " OK " + this.uidTag(byUid) + "MOVE completed\r\n"
    }

    // ── helpers ───────────────────────────────────────

    private int maxUid() {
        let n: int = this.SelUids.Count()
        if (n == 0) { return 0 }
        return this.SelUids.Get(n - 1)
    }
    private string uidTag(bool byUid) {
        if (byUid) { return "UID " }
        return ""
    }

    // nth whitespace-separated token (0-based); "" if absent.
    private static string token(string s, int idx) {
        let parts: List<string> = ImapSession.splitWs(s)
        if (idx < 0 || idx >= parts.Count()) { return "" }
        return parts.Get(idx)
    }
    // everything after the first `n` whitespace-separated tokens.
    private static string after(string s, int n) {
        var i: int = 0
        var seen: int = 0
        let len: int = String_Length(s)
        // skip leading ws
        while (i < len && ImapSession.isWs(String_CharAt1(s, i))) { i = i + 1 }
        while (seen < n && i < len) {
            while (i < len && !ImapSession.isWs(String_CharAt1(s, i))) { i = i + 1 }
            while (i < len && ImapSession.isWs(String_CharAt1(s, i))) { i = i + 1 }
            seen = seen + 1
        }
        if (i >= len) { return "" }
        return String_Substring(s, i, len - i)
    }
    private static List<string> splitWs(string s) {
        let out: List<string> = new List<string>()
        let len: int = String_Length(s)
        var i: int = 0
        while (i < len) {
            while (i < len && ImapSession.isWs(String_CharAt1(s, i))) { i = i + 1 }
            if (i >= len) { break }
            let start: int = i
            while (i < len && !ImapSession.isWs(String_CharAt1(s, i))) { i = i + 1 }
            out.Add(String_Substring(s, start, i - start))
        }
        return out
    }
    private static bool isWs(string c) { return c == " " || c == "\t" }

    private static string unquote(string s) {
        let n: int = String_Length(s)
        if (n >= 2) {
            let a: string = String_CharAt1(s, 0)
            let b: string = String_CharAt1(s, n - 1)
            if (a == "\"" && b == "\"") { return String_Substring(s, 1, n - 2) }
        }
        return s
    }
    private static string stripParens(string s) {
        var v: string = String_Trim(s)
        let n: int = String_Length(v)
        if (n >= 2 && String_CharAt1(v, 0) == "(" && String_CharAt1(v, n - 1) == ")") {
            v = String_Substring(v, 1, n - 2)
        }
        return String_Trim(v)
    }
    private static string join(string acc, string part) {
        if (String_Length(acc) == 0) { return part }
        return acc + " " + part
    }

    // Apply a STORE op (FLAGS / +FLAGS / -FLAGS, optionally .SILENT) to a
    // space-separated current flag list, returning the new list.
    // Les flags système IMAP sont insensibles à la casse : le client peut
    // envoyer \SEEN / \Deleted / \seen. On les canonicalise (\Seen, \Deleted…)
    // pour que le store, le webmail et nos vérifs (String_Contains "\\Seen") matchent.
    private static string normFlag(string f) {
        let u: string = String_ToUpper(f)
        if (u == "\\SEEN")     { return "\\Seen" }
        if (u == "\\DELETED")  { return "\\Deleted" }
        if (u == "\\FLAGGED")  { return "\\Flagged" }
        if (u == "\\ANSWERED") { return "\\Answered" }
        if (u == "\\DRAFT")    { return "\\Draft" }
        if (u == "\\RECENT")   { return "\\Recent" }
        return f
    }
    private static string normFlags(string flags) {
        let parts: List<string> = ImapSession.splitWs(flags)
        var out: string = ""
        var i: int = 0
        while (i < parts.Count()) {
            if (String_Length(out) > 0) { out = out + " " }
            out = out + ImapSession.normFlag(parts.Get(i))
            i = i + 1
        }
        return out
    }
    private static string applyFlags(string cur, string op, string flagsRaw) {
        let flags: string = ImapSession.normFlags(flagsRaw)
        let add: bool = String_Contains(op, "+")
        let del: bool = String_Contains(op, "-")
        if (!add && !del) { return String_Trim(flags) }     // replace
        let curList: List<string> = ImapSession.splitWs(cur)
        let argList: List<string> = ImapSession.splitWs(flags)
        let out: List<string> = new List<string>()
        // keep existing (minus removed)
        let cn: int = curList.Count()
        for i in 0..cn {
            let f: string = curList.Get(i)
            var drop: bool = false
            if (del) {
                let an: int = argList.Count()
                for j in 0..an { if (argList.Get(j) == f) { drop = true } }
            }
            if (!drop) { out.Add(f) }
        }
        if (add) {
            let an: int = argList.Count()
            for j in 0..an {
                let f: string = argList.Get(j)
                var have: bool = false
                let on: int = out.Count()
                for k in 0..on { if (out.Get(k) == f) { have = true } }
                if (!have) { out.Add(f) }
            }
        }
        var r: string = ""
        let rn: int = out.Count()
        for i in 0..rn {
            if (String_Length(r) > 0) { r = r + " " }
            r = r + out.Get(i)
        }
        return r
    }

    // Is `n` in an IMAP sequence/uid set ("1", "1:3", "1,3,5", "2:*", "*")?
    // `hi` is the max value (count for seq, max uid for uid).
    private static bool inSet(string spec, int n, int hi) {
        let groups: List<string> = ImapSession.splitChar(spec, ",")
        let g: int = groups.Count()
        for i in 0..g {
            let part: string = groups.Get(i)
            let colon: int = String_IndexOf(part, ":")
            if (colon < 0) {
                if (part == "*") { if (n == hi && hi > 0) { return true } }
                else { if (String_ToInt(part) == n) { return true } }
            } else {
                let lo: string = String_Substring(part, 0, colon)
                let hiS: string = String_Substring(part, colon + 1, String_Length(part) - colon - 1)
                var a: int = String_ToInt(lo)
                var b: int = hi
                if (hiS != "*") { b = String_ToInt(hiS) }
                if (a > b) { let t: int = a; a = b; b = t }
                if (n >= a && n <= b) { return true }
            }
        }
        return false
    }
    private static List<string> splitChar(string s, string sep) {
        let out: List<string> = new List<string>()
        var rest: string = s
        var idx: int = String_IndexOf(rest, sep)
        while (idx >= 0) {
            out.Add(String_Substring(rest, 0, idx))
            rest = String_Substring(rest, idx + 1, String_Length(rest) - idx - 1)
            idx = String_IndexOf(rest, sep)
        }
        out.Add(rest)
        return out
    }
}

// ── Transport: TcpServer accept loop + STARTTLS ───────────
public class ImapServer {
    public  Store:   MailStore
    public  Users:   Map<string, string>
    public  Host:    string
    private Cert:    string
    private Key:     string
    private HasCert: bool
    private Resolver: StoreResolver   // per-user store routing (null = shared)

    public ImapServer(store: MailStore, host: string) {
        this.Store = store
        this.Users = new Map<string, string>()
        this.Host = host
        this.Cert = ""
        this.Key = ""
        this.HasCert = false
        this.Resolver = null
    }
    public void AddPassword(string name, string plaintext) { this.Users.Set(name, Password.Hash(plaintext)) }
    public void AddUserHash(string name, string hash)      { this.Users.Set(name, hash) }
    public ImapServer WithCert(string certPath, string keyPath) {
        this.Cert = certPath; this.Key = keyPath; this.HasCert = true; return this
    }
    // Inject per-user store routing: on LOGIN the session switches to the
    // store returned by fn(login) → each account reads its own mailbox.
    public ImapServer WithStoreResolver(Closure<string, MailStore> fn) {
        this.Resolver = new StoreResolver(fn); return this
    }

    public void Serve(int port) {
        let srv = TcpServer_Listen(port, 64)
        while (TcpServer_IsListening(srv)) {
            let conn = TcpServer_Accept(srv)
            if (TcpConn_IsConnected(conn)) {
                var fd: int = -1
                @c { fd = ((AmalgameTcpConn*) conn)->_fd; }
                this.handle(fd)
            }
        }
        TcpServer_Close(srv)
    }

    // Implicit-TLS accept loop (IMAPS, :993) : the socket is TLS-wrapped
    // immediately on accept (no plaintext phase), then the IMAP dialogue runs
    // over TLS with the greeting sent encrypted. Requires WithCert.
    public void ServeTls(int port) {
        let srv = TcpServer_Listen(port, 64)
        while (TcpServer_IsListening(srv)) {
            let conn = TcpServer_Accept(srv)
            if (TcpConn_IsConnected(conn)) {
                var fd: int = -1
                @c { fd = ((AmalgameTcpConn*) conn)->_fd; }
                this.handleTls(fd)
            }
        }
        TcpServer_Close(srv)
    }

    private void handleTls(int fd) {
        if (!this.HasCert) { @c { close((int) fd); } return }
        let sess: ImapSession = new ImapSession(this.Store, this.Host)
        sess.Resolver = this.Resolver
        let keys: List<string> = this.Users.Keys()
        let nk: int = keys.Count()
        for i in 0..nk {
            let k: string = keys.Get(i)
            let v: string = this.Users.Get(k)
            sess.AddUserHash(k, v)
        }
        ImapServer.setRecvTimeout(fd, 60)
        let cfg0: TlsConfig = TlsConfig.Default()
        let cfg:  TlsConfig = TlsConfig.WithCertFile(cfg0, this.Cert, this.Key)
        let ctx:  TlsContext = TlsContext.Server(cfg)
        let tls:  TlsStream = TlsStream.Wrap(fd, ctx, true)
        let hs:   bool = TlsStream.Handshake(tls)
        if (hs) {
            sess.SetTlsActive(true)
            ImapServer.sendTls(tls, sess.Greeting())
            var tbuf: string = ""
            var done: bool = false
            while (!done) {
                let nl: int = String_IndexOf(tbuf, "\r\n")
                if (nl < 0) {
                    if (String_Length(tbuf) > 65536) { done = true }
                    else {
                        let chunk: string = ImapServer.recvTls(tls, 4096)
                        if (String_Length(chunk) == 0) { done = true }
                        else { tbuf = tbuf + chunk }
                    }
                } else {
                    let line: string = String_Substring(tbuf, 0, nl)
                    tbuf = String_Substring(tbuf, nl + 2, String_Length(tbuf) - nl - 2)
                    let resp: string = sess.Feed(line)
                    if (String_Length(resp) > 0) { ImapServer.sendTls(tls, resp) }
                    if (sess.IsLoggedOut()) { done = true }
                }
            }
        }
        TlsStream.Close(tls)
    }

    private void handle(int fd) {
        let sess: ImapSession = new ImapSession(this.Store, this.Host)
        sess.Resolver = this.Resolver
        let keys: List<string> = this.Users.Keys()
        let nk: int = keys.Count()
        for i in 0..nk {
            let k: string = keys.Get(i)
            let v: string = this.Users.Get(k)
            sess.AddUserHash(k, v)
        }
        ImapServer.setRecvTimeout(fd, 60)        // anti-slowloris
        ImapServer.sendFd(fd, sess.Greeting())

        // CRLF-strict framing (anti-smuggling) + per-line cap (anti-DoS).
        var buf: string = ""
        var phase: int = 0                       // 0 run, 1 done, 2 upgrade
        while (phase == 0) {
            let nl: int = String_IndexOf(buf, "\r\n")
            if (nl < 0) {
                if (String_Length(buf) > 65536) { phase = 1 }
                else {
                    let chunk: string = ImapServer.recvFd(fd, 4096)
                    if (String_Length(chunk) == 0) { phase = 1 }
                    else { buf = buf + chunk }
                }
            } else {
                let line: string = String_Substring(buf, 0, nl)
                buf = String_Substring(buf, nl + 2, String_Length(buf) - nl - 2)
                let resp: string = sess.Feed(line)
                if (String_Length(resp) > 0) { ImapServer.sendFd(fd, resp) }
                if (sess.IsLoggedOut()) { phase = 1 }
                else if (sess.WantsTlsUpgrade()) { phase = 2 }
            }
        }
        if (phase == 2 && this.HasCert) {
            let cfg0: TlsConfig = TlsConfig.Default()
            let cfg:  TlsConfig = TlsConfig.WithCertFile(cfg0, this.Cert, this.Key)
            let ctx:  TlsContext = TlsContext.Server(cfg)
            let tls:  TlsStream = TlsStream.Wrap(fd, ctx, true)
            let hs:   bool = TlsStream.Handshake(tls)
            if (hs) {
                sess.SetTlsActive(true)
                var tbuf: string = ""
                var done: bool = false
                while (!done) {
                    let nl: int = String_IndexOf(tbuf, "\r\n")
                    if (nl < 0) {
                        if (String_Length(tbuf) > 65536) { done = true }
                        else {
                            let chunk: string = ImapServer.recvTls(tls, 4096)
                            if (String_Length(chunk) == 0) { done = true }
                            else { tbuf = tbuf + chunk }
                        }
                    } else {
                        let line: string = String_Substring(tbuf, 0, nl)
                        tbuf = String_Substring(tbuf, nl + 2, String_Length(tbuf) - nl - 2)
                        let resp: string = sess.Feed(line)
                        if (String_Length(resp) > 0) { ImapServer.sendTls(tls, resp) }
                        if (sess.IsLoggedOut()) { done = true }
                    }
                }
            }
            TlsStream.Close(tls)
        }
        @c { close((int) fd); }
    }

    private static void setRecvTimeout(int fd, int secs) {
        @c {
            struct timeval tv;
            tv.tv_sec = (long) secs; tv.tv_usec = 0;
            setsockopt((int) fd, SOL_SOCKET, SO_RCVTIMEO, (const void*) &tv, sizeof(tv));
        }
    }
    private static string recvFd(int fd, int max) {
        var r: string = ""
        @c {
            char* b = (char*) GC_MALLOC((size_t) max + 1);
            long n = (long) recv((int) fd, b, (size_t) max, 0);
            if (n > 0) { b[n] = 0; r = (code_string) b; }
        }
        return r
    }
    private static bool sendFd(int fd, string data) {
        var ok: bool = false
        @c { long n = (long) send((int) fd, data, strlen(data), 0); ok = (n >= 0); }
        return ok
    }
    private static string recvTls(tls: TlsStream, max: int) {
        var r: string = ""
        @c {
            char* b = (char*) GC_MALLOC((size_t) max + 1);
            i64 n = Amalgame_Tls_TlsStream_ReadBytes((AmalgameTlsStream*) tls, b, (i64) max);
            if (n > 0) { b[n] = 0; r = (code_string) b; }
        }
        return r
    }
    private static bool sendTls(tls: TlsStream, data: string) {
        var ok: bool = false
        @c {
            i64 n = Amalgame_Tls_TlsStream_WriteBytes((AmalgameTlsStream*) tls, data, (i64) strlen(data));
            ok = (n >= 0);
        }
        return ok
    }
