// Test suite for amalgame-net-imap — the ImapSession state machine,
// driven with strings against a real local MailStore (no socket, no TLS;
// SetTlsActive(true) simulates post-STARTTLS).

namespace Tests

import Amalgame.Collections
import Amalgame.IO.Filesystem
import Amalgame.Database.SQLite
import Amalgame.Tls
import Amalgame.Net.Mail
import Amalgame.Net.Imap

public class Program {
    public static void Main(string[] args) {
        let root: string = "/tmp/amalgame-imap-test"
        Filesystem.Remove(root)
        let store: MailStore = MailStore.Open(root)
        let u1: int = store.Deliver("INBOX", "Subject: One\r\nFrom: a@b.com\r\n\r\nbody one")
        let u2: int = store.Deliver("INBOX", "Subject: Two\r\nFrom: c@d.com\r\n\r\nbody two")

        let s: ImapSession = new ImapSession(store, "imap.test")
        s.AddPassword("alice", "s3cret")

        // 1. greeting
        let g: string = s.Greeting()
        if (String_Contains(g, "* OK") && String_Contains(g, "CAPABILITY")) { Console.WriteLine("[PASS] greeting") }
        else { Console.WriteLine("[FAIL] greeting: " + g) }

        // 2. capability
        let c: string = s.Feed("a1 CAPABILITY")
        if (String_Contains(c, "* CAPABILITY IMAP4rev1") && String_Contains(c, "a1 OK")) { Console.WriteLine("[PASS] capability") }
        else { Console.WriteLine("[FAIL] capability: " + c) }

        // 3. login refused before TLS
        let l0: string = s.Feed("a2 LOGIN alice s3cret")
        if (String_Contains(l0, "a2 NO")) { Console.WriteLine("[PASS] login refused pre-tls") }
        else { Console.WriteLine("[FAIL] login refused pre-tls: " + l0) }

        s.SetTlsActive(true)

        // 4. login success
        let l1: string = s.Feed("a3 LOGIN alice s3cret")
        let authed: bool = s.Authed
        if (String_Contains(l1, "a3 OK") && authed) { Console.WriteLine("[PASS] login success") }
        else { Console.WriteLine("[FAIL] login success: " + l1) }

        // 5. login failure (separate session)
        let s2: ImapSession = new ImapSession(store, "imap.test")
        s2.AddPassword("alice", "s3cret")
        s2.SetTlsActive(true)
        let lf: string = s2.Feed("b1 LOGIN alice wrong")
        if (String_Contains(lf, "b1 NO")) { Console.WriteLine("[PASS] login failure") }
        else { Console.WriteLine("[FAIL] login failure: " + lf) }

        // 6. list
        let li: string = s.Feed("a4 LIST \"\" \"*\"")
        if (String_Contains(li, "INBOX") && String_Contains(li, "a4 OK")) { Console.WriteLine("[PASS] list") }
        else { Console.WriteLine("[FAIL] list: " + li) }

        // 7. select
        let sel: string = s.Feed("a5 SELECT INBOX")
        if (String_Contains(sel, "2 EXISTS") && String_Contains(sel, "UIDVALIDITY")
            && String_Contains(sel, "a5 OK")) { Console.WriteLine("[PASS] select") }
        else { Console.WriteLine("[FAIL] select: " + sel) }

        // 8. fetch body
        let fe: string = s.Feed("a6 FETCH 1 (FLAGS RFC822.SIZE BODY[])")
        if (String_Contains(fe, "* 1 FETCH (") && String_Contains(fe, "BODY[] {")
            && String_Contains(fe, "body one") && String_Contains(fe, "a6 OK")) { Console.WriteLine("[PASS] fetch body") }
        else { Console.WriteLine("[FAIL] fetch body: " + fe) }

        // 9. uid fetch
        let uf: string = s.Feed("a7 UID FETCH " + String_FromInt(u1) + " (FLAGS)")
        if (String_Contains(uf, "UID " + String_FromInt(u1)) && String_Contains(uf, "a7 OK UID FETCH")) { Console.WriteLine("[PASS] uid fetch") }
        else { Console.WriteLine("[FAIL] uid fetch: " + uf) }

        // 10. store +FLAGS \Seen
        let st: string = s.Feed("a8 STORE 1 +FLAGS (\\Seen)")
        let f1: string = store.Flags("INBOX", u1)
        if (String_Contains(st, "FLAGS (\\Seen)") && String_Contains(st, "a8 OK") && String_Contains(f1, "\\Seen")) { Console.WriteLine("[PASS] store flags") }
        else { Console.WriteLine("[FAIL] store flags: " + st + " | stored=" + f1) }

        // 11. search all
        let sa: string = s.Feed("a9 SEARCH ALL")
        if (String_Contains(sa, "* SEARCH 1 2") && String_Contains(sa, "a9 OK")) { Console.WriteLine("[PASS] search all") }
        else { Console.WriteLine("[FAIL] search all: " + sa) }

        // 12. search seen (only msg 1)
        let ss: string = s.Feed("a10 SEARCH SEEN")
        if (String_Contains(ss, "* SEARCH 1\r\n") && String_Contains(ss, "a10 OK")) { Console.WriteLine("[PASS] search seen") }
        else { Console.WriteLine("[FAIL] search seen: " + ss) }

        // 13. expunge a \Deleted message
        let sd: string = s.Feed("a11 STORE 2 +FLAGS (\\Deleted)")
        let ex: string = s.Feed("a12 EXPUNGE")
        let sel2: string = s.Feed("a13 SELECT INBOX")
        if (String_Contains(ex, "* 2 EXPUNGE") && String_Contains(ex, "a12 OK")
            && String_Contains(sel2, "1 EXISTS")) { Console.WriteLine("[PASS] expunge") }
        else { Console.WriteLine("[FAIL] expunge: " + ex + " | " + sel2) }

        // 15. AUTH brute-force lockout
        let lk: ImapSession = new ImapSession(store, "imap.test")
        lk.AddPassword("alice", "s3cret")
        lk.SetTlsActive(true)
        var lkf: int = 0
        for i in 0..5 {
            let rr: string = lk.Feed("z" + String_FromInt(i) + " LOGIN alice wrongpass")
            if (String_Contains(rr, "NO")) { lkf = lkf + 1 }
        }
        let lkd: string = lk.Feed("z9 LOGIN alice s3cret")
        if (lkf == 5 && String_Contains(lkd, "too many")) { Console.WriteLine("[PASS] login lockout") }
        else { Console.WriteLine("[FAIL] login lockout: lf=" + String_FromInt(lkf) + " r=" + lkd) }

        // 16. pollNew: nouveau mail après SELECT → NOOP renvoie un EXISTS non sollicité
        let u3: int = store.Deliver("INBOX", "Subject: Three\r\nFrom: e@f.com\r\n\r\nbody three")
        let noop: string = s.Feed("a13b NOOP")
        if (String_Contains(noop, "EXISTS") && String_Contains(noop, "a13b OK")) {
            Console.WriteLine("[PASS] noop reports new EXISTS")
        } else { Console.WriteLine("[FAIL] noop new EXISTS: " + noop) }

        // 17. INBOX insensible à la casse : SELECT "Inbox" voit les messages d'INBOX
        let selci: string = s.Feed("a13c SELECT \"Inbox\"")
        if (String_Contains(selci, "* 2 EXISTS") && String_Contains(selci, "a13c OK")) {
            Console.WriteLine("[PASS] INBOX case-insensitive")
        } else { Console.WriteLine("[FAIL] INBOX case: " + selci) }

        // 18. STATUS renvoie les compteurs
        let stat: string = s.Feed("a13d STATUS \"Inbox\" (MESSAGES UIDNEXT UNSEEN)")
        if (String_Contains(stat, "* STATUS") && String_Contains(stat, "MESSAGES 2") && String_Contains(stat, "a13d OK")) {
            Console.WriteLine("[PASS] STATUS")
        } else { Console.WriteLine("[FAIL] STATUS: " + stat) }

        // 19. FETCH style mobile : INTERNALDATE (pas 1970) + BODY[HEADER.FIELDS]
        let u4: int = store.Deliver("INBOX", "Date: Wed, 24 Jun 2026 15:30:00 +0000\r\nSubject: Mobile Test\r\nFrom: x@y.com\r\n\r\nhello mobile")
        let rs4: string = s.Feed("a13e SELECT \"Inbox\"")
        let ff: string = s.Feed("a13f UID FETCH " + String_FromInt(u4) + " (UID INTERNALDATE BODY.PEEK[HEADER.FIELDS (subject from date)])")
        if (String_Contains(ff, "INTERNALDATE \"24-Jun-2026") && String_Contains(ff, "BODY[HEADER.FIELDS") && String_Contains(ff, "Mobile Test")) {
            Console.WriteLine("[PASS] fetch internaldate + header.fields")
        } else { Console.WriteLine("[FAIL] fetch hdr: " + ff) }

        // 20. BODY[1] = contenu BRUT de la partie (le client décode via BODYSTRUCTURE)
        let enc: string = "Subject: Enc\r\nContent-Type: multipart/alternative; boundary=\"b\"\r\n\r\n--b\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\naGVsbG8gZGVjb2RlZA==\r\n--b--\r\n"
        let u5: int = store.Deliver("INBOX", enc)
        let rs5: string = s.Feed("a13g SELECT \"Inbox\"")
        let bt: string = s.Feed("a13h UID FETCH " + String_FromInt(u5) + " (BODY.PEEK[1] BODYSTRUCTURE)")
        if (String_Contains(bt, "aGVsbG8") && String_Contains(bt, "\"TEXT\" \"PLAIN\"") && String_Contains(bt, "\"BASE64\"")) {
            Console.WriteLine("[PASS] BODY[1] raw + bodystructure")
        } else { Console.WriteLine("[FAIL] BODY[1]/bodystructure: " + bt) }

        // 21. SYNC web→tel : suppression externe (store) → NOOP émet EXPUNGE
        store.Delete("INBOX", u4)
        let np1: string = s.Feed("a13i NOOP")
        if (String_Contains(np1, "EXPUNGE") && String_Contains(np1, "a13i OK")) {
            Console.WriteLine("[PASS] sync expunge on poll")
        } else { Console.WriteLine("[FAIL] sync expunge: " + np1) }

        // 22. SYNC lu/non-lu : flag changé hors session → NOOP émet FETCH FLAGS
        store.SetFlags("INBOX", u1, "\\Seen \\Flagged")
        let np2: string = s.Feed("a13j NOOP")
        if (String_Contains(np2, "FETCH") && String_Contains(np2, "\\Flagged") && String_Contains(np2, "a13j OK")) {
            Console.WriteLine("[PASS] sync flags on poll")
        } else { Console.WriteLine("[FAIL] sync flags: " + np2) }

        // 23. MOVE (tel → Corbeille) : message déplacé + EXPUNGE
        let mv: string = s.Feed("a13k UID MOVE " + String_FromInt(u5) + " Trash")
        let trashUids: List<int> = store.Uids("Trash")
        var inTrash: bool = false
        var ti2: int = 0
        while (ti2 < trashUids.Count()) {
            if (String_Contains(store.Read("Trash", trashUids.Get(ti2)), "aGVsbG8")) { inTrash = true }
            ti2 = ti2 + 1
        }
        if (String_Contains(mv, "EXPUNGE") && String_Contains(mv, "a13k OK") && inTrash) {
            Console.WriteLine("[PASS] move to Trash")
        } else { Console.WriteLine("[FAIL] move: " + mv + " inTrash=" + (inTrash ? "y" : "n")) }

        // 24. PIÈCE JOINTE : multipart/mixed (texte + image) → BODYSTRUCTURE expose
        // l'image (NAME) et BODY[2] renvoie ses données.
        let att: string = "Subject: Photo\r\nContent-Type: multipart/mixed; boundary=\"m\"\r\n\r\n--m\r\nContent-Type: text/plain\r\n\r\nvoici la photo\r\n--m\r\nContent-Type: image/jpeg; name=\"photo.jpg\"\r\nContent-Transfer-Encoding: base64\r\nContent-Disposition: attachment; filename=\"photo.jpg\"\r\n\r\n/9j/4AAQSkZJRgABAQ==\r\n--m--\r\n"
        let u6: int = store.Deliver("INBOX", att)
        let rs6: string = s.Feed("a13l SELECT \"Inbox\"")
        let bs6: string = s.Feed("a13m UID FETCH " + String_FromInt(u6) + " (BODYSTRUCTURE)")
        let b2: string = s.Feed("a13n UID FETCH " + String_FromInt(u6) + " (BODY.PEEK[2])")
        if (String_Contains(bs6, "\"IMAGE\" \"JPEG\"") && String_Contains(bs6, "photo.jpg") && String_Contains(bs6, "\"MIXED\"")
            && String_Contains(b2, "/9j/4AAQ")) {
            Console.WriteLine("[PASS] attachment bodystructure + part fetch")
        } else { Console.WriteLine("[FAIL] attachment: bs=" + bs6 + " b2=" + b2) }

        // 14. logout
        let lo: string = s.Feed("a14 LOGOUT")
        let out: bool = s.IsLoggedOut()
        if (String_Contains(lo, "* BYE") && String_Contains(lo, "a14 OK") && out) { Console.WriteLine("[PASS] logout") }
        else { Console.WriteLine("[FAIL] logout: " + lo) }
    }
}
